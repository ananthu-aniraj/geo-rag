# Geo-RAG Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# The '.env' file is gitignored and will never be committed.

# Flickr API Credentials
FLICKR_API_KEY=YOUR_FLICKR_API_KEY_HERE

# Mapillary API Access Token
MAPILLARY_TOKEN=YOUR_MAPILLARY_ACCESS_TOKEN_HERE

# HuggingFace API Token (Required for SGLang VLM model downloads)
HF_TOKEN=YOUR_HUGGING_FACE_ACCESS_TOKEN_HERE

# Wildlife Insights Session Cookie (Required for camera trap downloads; expires periodically and must be renewed from browser DevTools)
WILDLIFE_INSIGHTS_COOKIE="connect.sid=YOUR_CONNECT_SID_COOKIE_HERE"
# WILDLIFE_INSIGHTS_TOKEN="YOUR_BEARER_JWT_TOKEN_HERE"

# WildObs API Key (Required for camera trap image downloads)
WILDOBS_API_KEY=YOUR_WILDOBS_API_KEY_HERE

# Carto API Key (Required for Carto basemaps without "API key required" watermark and geospatial data)
CARTO_API_KEY=YOUR_CARTO_API_KEY_HERE
